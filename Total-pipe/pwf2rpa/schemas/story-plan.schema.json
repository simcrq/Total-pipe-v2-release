{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://total-pipe.local/schemas/story-plan.schema.json",
  "title": "Evidence-grounded research presentation story plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "planner",
    "core_question",
    "main_message",
    "story",
    "ending"
  ],
  "properties": {
    "content_contract": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "items"
          ],
          "properties": {
            "version": {
              "const": "1.0"
            },
            "items": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "visibility"
                ],
                "properties": {
                  "kind": {
                    "enum": [
                      "claim",
                      "condition",
                      "uncertainty",
                      "control",
                      "negative_result",
                      "interpretation",
                      "scope",
                      "detail"
                    ]
                  },
                  "visibility": {
                    "enum": [
                      "required",
                      "with_claim",
                      "notes_allowed"
                    ]
                  },
                  "applies_to": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "pattern": "\\S"
                    }
                  },
                  "reason": {
                    "type": "string",
                    "pattern": "\\S"
                  }
                }
              }
            }
          },
          "description": "Optional for legacy Story; new prompts require this versioned visibility contract. Runtime checks exact coverage and scope."
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "units",
            "narrative_map"
          ],
          "properties": {
            "version": {
              "const": "2.0"
            },
            "units": {
              "type": "object",
              "minProperties": 1,
              "propertyNames": {
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
              },
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "visibility",
                  "text",
                  "evidence",
                  "epistemic"
                ],
                "properties": {
                  "kind": {
                    "enum": [
                      "claim",
                      "condition",
                      "uncertainty",
                      "control",
                      "negative_result",
                      "interpretation",
                      "scope",
                      "detail"
                    ]
                  },
                  "visibility": {
                    "enum": [
                      "required",
                      "with_claim",
                      "notes_allowed"
                    ]
                  },
                  "applies_to": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "pattern": "\\S"
                    }
                  },
                  "reason": {
                    "type": "string",
                    "pattern": "\\S"
                  },
                  "text": {
                    "type": "string",
                    "pattern": "\\S"
                  },
                  "evidence": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "pattern": "^EV[0-9]{4}$"
                    }
                  },
                  "epistemic": {
                    "enum": [
                      "author_claim",
                      "observation",
                      "author_interpretation",
                      "agent_inference"
                    ]
                  }
                }
              }
            },
            "narrative_map": {
              "type": "object",
              "additionalProperties": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "\\S"
                }
              }
            }
          }
        }
      ],
      "description": "Legacy paragraph policy 1.0 or atomic scientific ledger 2.0. Prompt version controls new generation; semantic completeness and atomicity need source review."
    },
    "planner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "model",
        "reasoning_effort",
        "selected_by_user"
      ],
      "properties": {
        "mode": {
          "const": "subagent"
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "reasoning_effort": {
          "enum": [
            "high",
            "xhigh",
            "max",
            "ultra"
          ]
        },
        "selected_by_user": {
          "const": true
        }
      }
    },
    "core_question": {
      "type": "string",
      "minLength": 1
    },
    "main_message": {
      "type": "string",
      "minLength": 1
    },
    "story": {
      "type": "array",
      "minItems": 4,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "question",
          "answer",
          "evidence"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "answer": {
            "type": "string",
            "minLength": 1
          },
          "key_points": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^EV[0-9]{4}$"
            }
          },
          "next": {
            "type": "string",
            "minLength": 1,
            "description": "Required on every node except the last one."
          },
          "form": {
            "enum": [
              "sequence",
              "compare",
              "branch",
              "relation",
              "evidence",
              "prose"
            ]
          },
          "process_steps": {
            "type": "array",
            "minItems": 2,
            "maxItems": 5,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "comparison_dimensions": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "timeline_events": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "explain": {
            "$ref": "#/$defs/explain"
          }
        }
      }
    },
    "ending": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "takeaway"
      ],
      "properties": {
        "takeaway": {
          "type": "string",
          "minLength": 1
        },
        "limitation": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "$defs": {
    "obligation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "content",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "quantity",
            "parallel_items",
            "grouped_panels",
            "comparison",
            "ordered_steps",
            "relation",
            "curve",
            "image_evidence"
          ]
        },
        "required": {
          "type": "boolean",
          "default": true
        },
        "primary": {
          "type": "boolean",
          "default": false
        },
        "content": {
          "type": "object"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^EV[0-9]{4}$"
          }
        },
        "source_quote": {
          "type": "string"
        }
      }
    },
    "explain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "must_show"
      ],
      "properties": {
        "reader_task": {
          "type": "string"
        },
        "must_show": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/obligation"
          }
        },
        "must_not_lose": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "prose_ok_reason": {
          "type": "string",
          "description": "Required when must_show is empty."
        }
      }
    }
  }
}
