{
  "mcpServers": {
    "total_pipe": {
      "command": "python",
      "args": [
        "-m",
        "agent.mcp_server"
      ],
      "cwd": ".",
      "env": {
        "PYTHONUTF8": "1"
      },
      "env_vars": ["PATH", "PAPERWORKFLOW_CONFIG", "MINERU_TOKEN", "TOTALPIPE_AGENT_HOME", "TOTALPIPE_FONT_DIR"],
      "startup_timeout_sec": 30,
      "tool_timeout_sec": 1800
    }
  }
}
