{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Total-pipe P0 PageSpec",
  "type": "object",
  "required": ["schema_version", "deck_id", "theme", "pages"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "deck_id": {"type": "string", "minLength": 1},
    "theme": {
      "type": "object",
      "required": ["font"],
      "properties": {
        "font": {"type": "string"},
        "ink": {"type": "string"},
        "navy": {"type": "string"},
        "accent": {"type": "string"},
        "orange": {"type": "string"},
        "gray": {"type": "string"},
        "light": {"type": "string"}
      }
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "items": {
        "type": "object",
        "required": ["id", "title", "take", "objects"],
        "properties": {
          "id": {"type": "string"},
          "section": {"type": "string"},
          "title": {"type": "string"},
          "take": {"type": "string"},
          "footer": {"type": "boolean", "default": true},
          "objects": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["type", "box"],
              "properties": {
                "type": {"enum": ["text", "image", "shape", "line", "table"]},
                "box": {"type": "array", "minItems": 4, "maxItems": 4},
                "role": {"enum": ["body", "label", "caption", "note"]},
                "text": {"type": "string"},
                "size": {"type": "number"},
                "bold": {"type": "boolean"},
                "italic": {"type": "boolean"},
                "color": {"type": "string"},
                "align": {"enum": ["left", "center", "right"]},
                "valign": {"enum": ["top", "middle", "bottom"]},
                "line_spacing": {"type": "number"},
                "bullet": {"type": "boolean"},
                "path": {"type": "string"},
                "fit": {"enum": ["contain", "cover"]},
                "shape": {"enum": ["rect", "rounded", "oval", "arrow", "chevron"]},
                "fill": {"type": "string"},
                "stroke": {"type": "string"},
                "stroke_width": {"type": "number"},
                "dash": {"type": "boolean"},
                "rows": {"type": "array"},
                "col_widths": {"type": "array"},
                "row_height": {"type": "number"},
                "header": {"type": "boolean"},
                "font_size": {"type": "number"},
                "accent_rows": {"type": "array"}
              }
            }
          }
        }
      }
    }
  }
}
