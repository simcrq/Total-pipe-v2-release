{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://total-pipe.local/schemas/deck-ir.schema.json",
  "title": "Canonical Deck IR v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "deck_id", "theme", "assets", "slides"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "deck_id": {"type": "string", "minLength": 1},
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "academic_design": {"$ref": "#/$defs/academic-design"},
        "text_capacity_policy": {"enum": ["strict", "preserve-terms"],
          "description": "V6 defaults to preserve-terms: title/body budgets and visible text overflow require REVIEW without rewriting terminology. Legacy IR defaults to strict."},
        "frame_variant": {"enum": ["default", "spacious"]},
        "bullet_style": {
          "enum": ["bullet", "square", "open_square", "diamond", "arrow", "check", "dash"],
          "description": "Native list marker used on every list page of this deck."
        },
        "list_gap": {
          "type": "number", "minimum": 0.1, "maximum": 1.5,
          "description": "Space between list items as a fraction of the line height (default 0.45)."
        }
      }
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "required": ["font_family", "font_file", "bold_font_file"],
      "properties": {
        "font_family": {"type": "string", "minLength": 1},
        "font_file": {"type": "string", "minLength": 1},
        "bold_font_file": {"type": "string", "minLength": 1},
        "foreground": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
        "background": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
        "accent": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$",
                   "description": "List markers, step badges and emphasis. Defaults to #C2410C."},
        "background_image": {"type": "string", "minLength": 1,
                             "description": "Full-bleed picture drawn under every slide, relative to deck_ir.json. Its contrast against the text colour is measured before the build."}
      }
    },
    "assets": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "source_figure": {"type": "string", "pattern": "^[1-9][0-9]*[a-z]?$"},
          "origin": {"enum": ["paper", "generated"],
                     "description": "paper (default) = cropped from the paper; generated = drawn by the pipeline."},
          "generator": {"type": "string", "minLength": 1,
                        "description": "Required when origin is generated: tool and version, e.g. make_schematic.py/flow."}
        }
      }
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/slide"}
    }
  },
  "allOf": [{
    "if": {"required": ["presentation"], "properties": {"presentation": {"anyOf": [
      {"required": ["text_capacity_policy"], "properties": {"text_capacity_policy": {"const": "preserve-terms"}}},
      {"required": ["academic_design"], "not": {"required": ["text_capacity_policy"],
        "properties": {"text_capacity_policy": {"const": "strict"}}}}
    ]}}},
    "else": {"properties": {"slides": {"items": {"properties": {
      "semantic": {"properties": {"title": {"maxLength": 120}, "takeaway": {"maxLength": 180}}},
      "composition": {"properties": {"blocks": {"items": {"properties": {"text": {"maxLength": 600}}}}}}
    }}}}}
  }],
  "$defs": {
    "layout-tree": {
      "type": "object", "additionalProperties": false, "required": ["version", "regions"],
      "properties": {
        "version": {"const": "1.0"},
        "regions": {"type": "object", "additionalProperties": false, "required": ["body"],
                    "properties": {"body": {"$ref": "#/$defs/region-node"}}}
      },
      "description": "Bounded body tree: runtime enforces depth <= 6, nodes <= 64, exact content coverage and formula-anchor groups. No page coordinates."
    },
    "region-node": {
      "allOf": [{"$ref": "#/$defs/region-depth-1"}],
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["id", "type", "children"],
         "properties": {
           "id": {"$ref": "#/$defs/identifier"}, "type": {"enum": ["columns", "stack"]},
           "children": {"type": "array", "minItems": 1, "maxItems": 12,
                        "items": {"$ref": "#/$defs/region-node"}},
           "weights": {"type": "array", "minItems": 1, "maxItems": 12,
                       "items": {"type": "number", "minimum": 0.1, "maximum": 10}},
           "gap": {"enum": ["compact", "standard", "spacious"]}},
         "allOf": [{"if": {"properties": {"type": {"const": "columns"}}},
                    "then": {"properties": {"children": {"maxItems": 4}, "weights": {"maxItems": 4}}}}]},
        {"type": "object", "additionalProperties": false, "required": ["id", "type", "title", "body"],
         "properties": {
           "id": {"$ref": "#/$defs/identifier"}, "type": {"const": "panel"},
           "title": {"type": "string", "minLength": 1, "pattern": "\\S"},
           "body": {"$ref": "#/$defs/region-node"},
           "padding": {"enum": ["none", "compact", "standard"]},
           "gap": {"enum": ["compact", "standard", "spacious"]}}},
        {"type": "object", "additionalProperties": false, "required": ["id", "type", "columns", "children"],
         "properties": {
           "id": {"$ref": "#/$defs/identifier"}, "type": {"const": "image_grid"},
           "columns": {"type": "integer", "minimum": 1, "maximum": 4},
           "children": {"type": "array", "minItems": 1, "maxItems": 12,
                        "items": {"$ref": "#/$defs/region-figure"}},
           "gap": {"enum": ["compact", "standard", "spacious"]}}},
        {"type": "object", "additionalProperties": false, "required": ["id", "type", "ref"],
         "properties": {"id": {"$ref": "#/$defs/identifier"}, "type": {"enum": ["block", "graphic"]},
                        "ref": {"type": "string", "minLength": 1}}},
        {"$ref": "#/$defs/region-figure"}
      ]
    },
    "region-depth-1": {"properties": {"body": {"$ref": "#/$defs/region-depth-2"},
      "children": {"items": {"$ref": "#/$defs/region-depth-2"}}}},
    "region-depth-2": {"properties": {"body": {"$ref": "#/$defs/region-depth-3"},
      "children": {"items": {"$ref": "#/$defs/region-depth-3"}}}},
    "region-depth-3": {"properties": {"body": {"$ref": "#/$defs/region-depth-4"},
      "children": {"items": {"$ref": "#/$defs/region-depth-4"}}}},
    "region-depth-4": {"properties": {"body": {"$ref": "#/$defs/region-depth-5"},
      "children": {"items": {"$ref": "#/$defs/region-depth-5"}}}},
    "region-depth-5": {"properties": {"body": {"$ref": "#/$defs/region-depth-6"},
      "children": {"items": {"$ref": "#/$defs/region-depth-6"}}}},
    "region-depth-6": {"not": {"anyOf": [{"required": ["body"]}, {"required": ["children"]}]}},
    "region-figure": {
      "type": "object", "additionalProperties": false, "required": ["id", "type", "ref"],
      "properties": {"id": {"$ref": "#/$defs/identifier"}, "type": {"const": "figure"},
                     "ref": {"type": "integer", "minimum": 0}}
    },
    "academic-design": {
      "type": "object", "additionalProperties": false,
      "required": ["style", "title_treatment", "density", "figure_treatment", "decoration_policy"],
      "properties": {
        "style": {"const": "research-seminar"},
        "title_treatment": {"enum": ["plain", "thin-rule"]},
        "density": {"enum": ["balanced", "compact"]},
        "figure_treatment": {"enum": ["unframed", "ruled-caption"]},
        "decoration_policy": {"enum": ["minimal", "none"]},
        "header_variant": {"enum": ["standard", "compact"], "default": "compact"},
        "type_scale": {"enum": ["standard", "compact"], "default": "standard"},
        "accent_color": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"}
      },
      "allOf": [{
        "if": {"properties": {"decoration_policy": {"const": "none"}}},
        "then": {"properties": {"title_treatment": {"const": "plain"},
                                 "figure_treatment": {"const": "unframed"}}}
      }]
    },
    "visual-plan": {
      "type": "object", "additionalProperties": false,
      "required": ["visual_job", "primary", "composition"],
      "properties": {
        "visual_job": {"enum": ["measurement-evidence", "mechanism-explanation", "evidence-comparison"]},
        "primary": {
          "type": "object", "additionalProperties": false, "required": ["kind", "index"],
          "properties": {"kind": {"enum": ["figure", "graphic"]},
                         "index": {"type": "integer", "minimum": 0}}
        },
        "composition": {"enum": ["figure-left", "figure-right", "figure-top",
          "graphic-left", "graphic-right", "graphic-top", "evidence-columns", "evidence-rows"]},
        "figure_width_ratio": {"type": "number", "minimum": 0.35, "maximum": 0.75},
        "graphic_width_ratio": {"type": "number", "minimum": 0.4, "maximum": 1},
        "evidence_order": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true,
                           "items": {"type": "integer", "minimum": 0, "maximum": 1}},
        "context_placement": {"enum": ["above-visuals", "with-evidence"]},
        "emphasis": {
          "type": "object", "additionalProperties": false, "required": ["source", "text", "treatment"],
          "properties": {
            "source": {"type": "string", "minLength": 1},
            "text": {"type": "string", "minLength": 1, "maxLength": 80, "pattern": "\\S"},
            "treatment": {"const": "inline-callout"}
          }
        }
      },
      "allOf": [{
        "if": {"properties": {"visual_job": {"const": "measurement-evidence"}}},
        "then": {"properties": {
          "primary": {"properties": {"kind": {"const": "figure"}}},
          "composition": {"enum": ["figure-left", "figure-right", "figure-top"]}},
          "not": {"anyOf": [{"required": ["graphic_width_ratio"]}, {"required": ["context_placement"]},
                            {"required": ["evidence_order"]}]}}
      }, {
        "if": {"properties": {"visual_job": {"const": "mechanism-explanation"}}},
        "then": {"properties": {
          "primary": {"properties": {"kind": {"const": "graphic"}}},
          "composition": {"enum": ["graphic-left", "graphic-right", "graphic-top"]}},
          "not": {"anyOf": [{"required": ["figure_width_ratio"]}, {"required": ["evidence_order"]}]}}
      }, {
        "if": {"properties": {"visual_job": {"const": "evidence-comparison"}}},
        "then": {"properties": {
          "primary": {"properties": {"kind": {"const": "figure"}}},
          "composition": {"enum": ["evidence-columns", "evidence-rows"]}},
          "not": {"anyOf": [{"required": ["graphic_width_ratio"]}, {"required": ["context_placement"]}]}}
      }, {
        "if": {"properties": {"composition": {"const": "evidence-rows"}}},
        "then": {"not": {"required": ["figure_width_ratio"]}}
      }, {
        "if": {"properties": {"composition": {"const": "graphic-top"}}},
        "then": {"not": {"required": ["context_placement"]}}
      }]
    },
    "graphic": {
      "oneOf": [
        {"$ref": "#/$defs/process-graphic"}, {"$ref": "#/$defs/mechanism-graphic"},
        {"$ref": "#/$defs/architecture-graphic"}, {"$ref": "#/$defs/funnel-graphic"},
        {"$ref": "#/$defs/path-graphic"}, {"$ref": "#/$defs/composite-graphic"}
      ]
    },
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$"},
    "process-graphic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "direction", "nodes", "edges"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$"},
        "type": {"enum": ["process", "dag"]},
        "direction": {"const": "horizontal"},
        "nodes": {
          "type": "array", "minItems": 1, "maxItems": 16,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "title"],
            "properties": {
              "id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$"},
              "shape": {"enum": ["rect", "rounded-rect", "ellipse", "diamond", "hexagon"]},
              "title": {"type": "string", "minLength": 1, "maxLength": 80, "pattern": "\\S"},
              "body": {"type": "string", "maxLength": 180}
            }
          }
        },
        "edges": {
          "type": "array", "maxItems": 64,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["from", "to"],
            "properties": {
              "from": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$"},
              "to": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$"},
              "kind": {"const": "arrow"}
            }
          }
        }
      },
      "allOf": [{
        "if": {"properties": {"type": {"const": "process"}}},
        "then": {"properties": {"nodes": {"minItems": 3, "maxItems": 4},
                                "edges": {"minItems": 2, "maxItems": 3}}}
      }]
    },
    "mechanism-graphic": {
      "type": "object", "additionalProperties": false, "required": ["id", "type", "nodes", "edges"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"}, "type": {"const": "mechanism"},
        "direction": {"const": "horizontal"},
        "nodes": {"$ref": "#/$defs/process-graphic/properties/nodes"},
        "edges": {
          "type": "array", "maxItems": 64,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["from", "to", "kind", "basis"],
            "properties": {
              "from": {"$ref": "#/$defs/identifier"}, "to": {"$ref": "#/$defs/identifier"},
              "kind": {"enum": ["activate", "inhibit", "associate"]},
              "basis": {"enum": ["evidence", "hypothesis"]}, "feedback": {"type": "boolean"},
              "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1, "pattern": "\\S"}},
              "label": {"type": "string", "minLength": 1, "maxLength": 80, "pattern": "\\S"}
            },
            "allOf": [{"if": {"properties": {"basis": {"const": "evidence"}}},
                       "then": {"required": ["evidence_refs"], "properties": {"evidence_refs": {"minItems": 1}}}}]
          }
        }
      }
    },
    "architecture-graphic": {
      "type": "object", "additionalProperties": false, "required": ["id", "type", "layers", "edges"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"}, "type": {"const": "architecture"},
        "direction": {"const": "horizontal"}, "edges": {"$ref": "#/$defs/process-graphic/properties/edges"},
        "layers": {
          "type": "array", "minItems": 1, "maxItems": 4,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["id", "title", "nodes"],
            "properties": {
              "id": {"$ref": "#/$defs/identifier"},
              "title": {"type": "string", "minLength": 1, "maxLength": 80, "pattern": "\\S"},
              "nodes": {"type": "array", "minItems": 1, "maxItems": 4,
                        "items": {"$ref": "#/$defs/process-graphic/properties/nodes/items"}}
            }
          }
        }
      }
    },
    "funnel-graphic": {
      "type": "object", "additionalProperties": false, "required": ["id", "type", "levels"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"}, "type": {"const": "funnel"},
        "variant": {"enum": ["funnel", "pyramid"]}, "end_width": {"type": "number", "minimum": 0, "maximum": 1},
        "levels": {
          "type": "array", "minItems": 2, "maxItems": 8,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["id", "title"],
            "properties": {
              "id": {"$ref": "#/$defs/identifier"},
              "title": {"type": "string", "minLength": 1, "maxLength": 80, "pattern": "\\S"},
              "body": {"type": "string", "maxLength": 180}
            }
          }
        }
      },
      "allOf": [{"if": {"not": {"required": ["variant"], "properties": {"variant": {"const": "pyramid"}}}},
                 "then": {"properties": {"end_width": {"minimum": 0.2}}}}]
    },
    "path-command": {
      "oneOf": [
        {"type": "array", "prefixItems": [{"const": "M"}], "items": {"type": "number"}, "minItems": 3, "maxItems": 3},
        {"type": "array", "prefixItems": [{"const": "L"}], "items": {"type": "number"}, "minItems": 3, "maxItems": 3},
        {"type": "array", "prefixItems": [{"const": "C"}], "items": {"type": "number"}, "minItems": 7, "maxItems": 7},
        {"type": "array", "prefixItems": [{"const": "Q"}], "items": {"type": "number"}, "minItems": 5, "maxItems": 5},
        {"type": "array", "prefixItems": [{"const": "Z"}], "minItems": 1, "maxItems": 1}
      ]
    },
    "local-box": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"},
                  {"type": "number", "exclusiveMinimum": 0}, {"type": "number", "exclusiveMinimum": 0}],
                  "minItems": 4, "maxItems": 4},
    "path-color": {"type": "string", "pattern": "^(accent|foreground|background|none|#[0-9A-Fa-f]{6})$"},
    "path-graphic": {
      "type": "object", "additionalProperties": false, "required": ["id", "type", "view_box", "paths"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"}, "type": {"const": "path"}, "view_box": {"$ref": "#/$defs/local-box"},
        "paths": {
          "type": "array", "minItems": 1, "maxItems": 32,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["id"],
            "properties": {
              "id": {"$ref": "#/$defs/identifier"},
              "commands": {"type": "array", "minItems": 2, "maxItems": 512, "items": {"$ref": "#/$defs/path-command"}},
              "d": {"type": "string", "minLength": 1, "maxLength": 32000},
              "fill": {"$ref": "#/$defs/path-color"}, "stroke": {"$ref": "#/$defs/path-color"},
              "line_width": {"type": "number", "minimum": 0.5, "maximum": 6}
            },
            "oneOf": [{"required": ["commands"], "not": {"required": ["d"]}},
                      {"required": ["d"], "not": {"required": ["commands"]}}]
          }
        },
        "labels": {
          "type": "array", "maxItems": 32,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["id", "text", "box"],
            "properties": {"id": {"$ref": "#/$defs/identifier"}, "box": {"$ref": "#/$defs/local-box"},
                           "text": {"type": "string", "minLength": 1, "maxLength": 180, "pattern": "\\S"}}
          }
        }
      }
    },
    "composite-graphic": {
      "type": "object", "additionalProperties": false, "required": ["id", "type", "components"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"}, "type": {"const": "composite"},
        "arrangement": {"enum": ["columns", "rows"]},
        "weights": {"type": "array", "minItems": 2, "maxItems": 4,
                    "items": {"type": "number", "minimum": 0.01, "maximum": 100}},
        "components": {
          "type": "array", "minItems": 2, "maxItems": 4,
          "items": {"oneOf": [
            {"$ref": "#/$defs/process-graphic"}, {"$ref": "#/$defs/mechanism-graphic"},
            {"$ref": "#/$defs/architecture-graphic"}, {"$ref": "#/$defs/funnel-graphic"}, {"$ref": "#/$defs/path-graphic"}
          ]}
        }
      }
    },
    "slide": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "semantic", "composition", "presentation"],
      "allOf": [{"if": {"properties": {"composition": {"required": ["layout_tree"]}}},
        "then": {"properties": {"presentation": {"not": {"required": ["visual_plan"]}}}}}],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "semantic": {
          "type": "object",
          "additionalProperties": false,
          "required": ["title", "purpose", "takeaway", "evidence_refs", "caveats", "speaker_notes"],
          "properties": {
            "title": {"type": "string", "minLength": 1},
            "purpose": {"type": "string", "minLength": 1},
            "takeaway": {"type": "string", "minLength": 1},
            "evidence_refs": {"type": "array", "items": {"type": "string"}},
            "caveats": {"type": "array", "items": {"type": "string"}},
            "run_notes": {"type": "array", "items": {"type": "string"}},
            "speaker_notes": {"type": "string", "minLength": 1}
          }
        },
        "composition": {
          "type": "object",
          "additionalProperties": false,
          "required": ["archetype", "blocks", "figure_refs"],
          "properties": {
            "archetype": {
              "enum": [
                "composite-research", "native-graphic", "cover-hero", "metric-comparison", "equation-derivation", "process-flow", "figure-parameters",
                "hero-dual-evidence", "evidence-hypothesis", "dual-demonstration",
                "three-limitations", "three-conclusions"
              ]
            },
            "graphics": {
              "type": "array", "maxItems": 8,
              "items": {"$ref": "#/$defs/graphic"},
              "description": "One editable process/DAG, scientific component, Path IR scene or composite. Optional on process-flow and figure-parameters; required on native-graphic. Only Path IR uses local coordinates; page geometry is compiler-owned."
            },
            "blocks": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "component", "text"],
                "properties": {
                  "id": {"type": "string", "minLength": 1},
                  "component": {
                    "enum": [
                      "body", "metric", "parameter", "process-step", "direct-evidence",
                      "hypothesis", "limitation", "conclusion", "callout", "comparison",
                      "definition", "observation", "method", "result", "question", "source", "caveat", "formula"
                    ]
                  },
                  "label": {"type": "string"},
                  "text": {"type": "string", "minLength": 1},
                  "text_flow": {"enum": ["auto", "plain", "distributed_arrow_list"]},
                  "anchor": {"type": "string", "minLength": 1,
                             "description": "Formula only: id of a preceding non-formula block this equation explains. Explicit anchored groups stay together; consecutive unanchored equations remain independent measured rows."}
                }
              }
            },
            "layout_tree": {"$ref": "#/$defs/layout-tree"},
            "visual_intent": {
              "type": "object",
              "additionalProperties": false,
              "required": ["relation", "members", "orientation", "preserve_order"],
              "properties": {
                "relation": {"const": "process"},
                "members": {"type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true,
                  "items": {"type": "string", "minLength": 1}},
                "orientation": {"const": "vertical"},
                "preserve_order": {"const": true},
                "emphasis": {"type": "string", "minLength": 1}
              }
            },
            "figure_refs": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["asset_id", "caption"],
                "properties": {
                  "asset_id": {"type": "string", "minLength": 1},
                  "caption": {"type": "string", "maxLength": 180},
                  "alt": {"type": "string"},
                  "panel_count": {"type": "integer", "minimum": 1, "maximum": 6},
                  "source_figure": {"type": "string", "pattern": "^[1-9][0-9]*[a-z]?$",
                                    "description": "Paper figure id. Required for paper assets, forbidden for generated ones."},
                  "min_panel_extent": {"type": "number", "minimum": 140, "maximum": 500},
                  "caption_height": {"type": "number", "minimum": 24, "maximum": 96},
                  "caption_font_size": {"type": "number", "minimum": 12, "maximum": 28},
                  "caption_font_floor": {"type": "number", "minimum": 10, "maximum": 28}
                }
              }
            }
          },
          "allOf": [{
            "if": {"required": ["layout_tree"]},
            "then": {"not": {"required": ["visual_intent"]}},
            "else": {"properties": {"graphics": {"maxItems": 1}}}
          }, {
            "if": {"properties": {"archetype": {"const": "composite-research"}}},
            "then": {"required": ["layout_tree"]}
          }, {
            "if": {"not": {"required": ["layout_tree"]}},
            "then": {
            "if": {"properties": {"archetype": {"const": "native-graphic"}}},
            "then": {
              "required": ["graphics"],
              "properties": {"graphics": {"minItems": 1}, "blocks": {"maxItems": 0},
                             "figure_refs": {"maxItems": 0}}
            },
            "else": {
              "if": {"properties": {"archetype": {"enum": ["process-flow", "figure-parameters"]}}},
              "else": {"properties": {"graphics": {"maxItems": 0}}}
            }
            }
          }, {
            "if": {"required": ["graphics"], "properties": {"graphics": {"minItems": 1}}},
            "then": {"not": {"required": ["visual_intent"]}}
          }]
        },
        "presentation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "visual_plan": {"$ref": "#/$defs/visual-plan"},
            "variant": {"enum": ["default", "spacious"]},
            "theme_tokens": {"type": "object"},
            "component_variants": {"type": "object"},
            "optional_overrides": {"type": "object", "maxProperties": 0}
          }
        }
      }
    }
  }
}
