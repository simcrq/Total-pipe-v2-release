{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://total-pipe.local/schemas/deck-ir.schema.json",
  "title": "Canonical Deck IR v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "deck_id", "theme", "assets", "slides"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "deck_id": {"type": "string", "minLength": 1},
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "required": ["font_family", "font_file", "bold_font_file"],
      "properties": {
        "font_family": {"type": "string", "minLength": 1},
        "font_file": {"type": "string", "minLength": 1},
        "bold_font_file": {"type": "string", "minLength": 1},
        "foreground": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
        "background": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"}
      }
    },
    "assets": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "source_figure": {"type": "string", "pattern": "^[1-9][0-9]*[a-z]?$"}
        }
      }
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/slide"}
    }
  },
  "$defs": {
    "slide": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "semantic", "composition", "presentation"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "semantic": {
          "type": "object",
          "additionalProperties": false,
          "required": ["title", "purpose", "takeaway", "evidence_refs", "caveats", "speaker_notes"],
          "properties": {
            "title": {"type": "string", "minLength": 1, "maxLength": 120},
            "purpose": {"type": "string", "minLength": 1},
            "takeaway": {"type": "string", "minLength": 1, "maxLength": 180},
            "evidence_refs": {"type": "array", "items": {"type": "string"}},
            "caveats": {"type": "array", "items": {"type": "string"}},
            "speaker_notes": {"type": "string", "minLength": 1}
          }
        },
        "composition": {
          "type": "object",
          "additionalProperties": false,
          "required": ["archetype", "blocks", "figure_refs"],
          "properties": {
            "archetype": {
              "enum": [
                "cover-hero", "metric-comparison", "process-flow", "figure-parameters",
                "hero-dual-evidence", "evidence-hypothesis", "dual-demonstration",
                "three-limitations", "three-conclusions"
              ]
            },
            "blocks": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "component", "text"],
                "properties": {
                  "id": {"type": "string", "minLength": 1},
                  "component": {
                    "enum": [
                      "body", "metric", "parameter", "process-step", "direct-evidence",
                      "hypothesis", "limitation", "conclusion", "callout", "comparison",
                      "definition", "observation", "method", "result", "question", "source", "caveat"
                    ]
                  },
                  "label": {"type": "string"},
                  "text": {"type": "string", "minLength": 1, "maxLength": 600},
                  "text_flow": {"enum": ["auto", "plain", "distributed_arrow_list"]}
                }
              }
            },
            "figure_refs": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["asset_id", "caption", "source_figure"],
                "properties": {
                  "asset_id": {"type": "string", "minLength": 1},
                  "caption": {"type": "string", "maxLength": 180},
                  "alt": {"type": "string"},
                  "panel_count": {"type": "integer", "minimum": 1, "maximum": 6},
                "source_figure": {"type": "string", "pattern": "^[1-9][0-9]*[a-z]?$"},
                  "min_panel_extent": {"type": "number", "minimum": 140, "maximum": 500},
                  "caption_height": {"type": "number", "minimum": 24, "maximum": 96},
                  "caption_font_size": {"type": "number", "minimum": 12, "maximum": 28},
                  "caption_font_floor": {"type": "number", "minimum": 10, "maximum": 28}
                }
              }
            }
          }
        },
        "presentation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "variant": {"enum": ["default", "spacious"]},
            "theme_tokens": {"type": "object"},
            "component_variants": {"type": "object"},
            "optional_overrides": {"type": "object", "maxProperties": 0}
          }
        }
      }
    }
  }
}
