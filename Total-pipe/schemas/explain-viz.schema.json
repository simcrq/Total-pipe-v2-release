{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://totalpipe.local/schemas/explain-viz.schema.json",
  "title": "ExplainViz proposal 1.0 (sidecar, not Deck IR)",
  "$ref": "#/$defs/proposal",
  "$defs": {
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "ir_sha256",
        "slots_sha256",
        "slides"
      ],
      "properties": {
        "version": {
          "const": "1.0"
        },
        "ir_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "slots_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "slides": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "slide_id",
                  "reason",
                  "decision"
                ],
                "properties": {
                  "slide_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 240,
                    "pattern": "\\S"
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 240,
                    "pattern": "\\S"
                  },
                  "decision": {
                    "const": "skip"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "slide_id",
                  "reason",
                  "decision",
                  "scores",
                  "teaching_goal",
                  "visual_spec"
                ],
                "properties": {
                  "slide_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 240,
                    "pattern": "\\S"
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 240,
                    "pattern": "\\S"
                  },
                  "decision": {
                    "const": "draw"
                  },
                  "scores": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "explanation_gain",
                      "relationship_clarity",
                      "source_confidence",
                      "layout_fit",
                      "redundancy"
                    ],
                    "properties": {
                      "explanation_gain": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "relationship_clarity": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "source_confidence": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "layout_fit": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "redundancy": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      }
                    }
                  },
                  "teaching_goal": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 240,
                    "pattern": "\\S"
                  },
                  "visual_spec": {
                    "$ref": "#/$defs/visual_spec"
                  }
                }
              }
            ]
          }
        }
      }
    },
    "visual_spec": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "template",
            "source_fact_ids",
            "labels",
            "relations"
          ],
          "properties": {
            "version": {
              "const": "1.0"
            },
            "template": {
              "const": "geometry/peel_angle@1"
            },
            "source_fact_ids": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^(semantic\\.(title|takeaway)|block:.+)$"
              }
            },
            "labels": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "substrate",
                "film",
                "theta"
              ],
              "properties": {
                "substrate": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 48,
                  "pattern": "^[^\\r\\n]*\\S[^\\r\\n]*$"
                },
                "film": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 48,
                  "pattern": "^[^\\r\\n]*\\S[^\\r\\n]*$"
                },
                "theta": {
                  "enum": [
                    "θ",
                    "theta",
                    "Θ"
                  ]
                }
              }
            },
            "relations": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "type",
                    "from",
                    "to",
                    "source_fact_ids"
                  ],
                  "properties": {
                    "type": {
                      "const": "attached_to"
                    },
                    "from": {
                      "const": "film"
                    },
                    "to": {
                      "const": "substrate"
                    },
                    "source_fact_ids": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 8,
                      "uniqueItems": true,
                      "items": {
                        "type": "string",
                        "pattern": "^(semantic\\.(title|takeaway)|block:.+)$"
                      }
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
