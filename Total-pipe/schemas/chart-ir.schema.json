{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://total-pipe.local/schemas/chart-ir.schema.json",
  "title": "Total-pipe Chart IR v1 (draft, renderer pending)",
  "description": "One measured, editable data plot. Cross-array rules (series length == x length, monotonic x, log-domain positivity, evidence binding) are enforced by deck_compiler.chart_layout.validate_charts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "kind", "basis", "x", "y", "series"],
  "properties": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$"},
    "kind": {"enum": ["line", "bar"]},
    "basis": {"enum": ["evidence", "explain"],
              "description": "evidence: every plotted value must occur in the cited evidence. explain: a schematic the page adds; requires illustrative=true and renders a visible badge."},
    "illustrative": {"type": "boolean", "default": false},
    "x": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "values"],
      "properties": {
        "label": {"type": "string", "minLength": 1, "maxLength": 80, "pattern": "\\S"},
        "scale": {"enum": ["linear", "log"], "default": "linear"},
        "values": {"type": "array", "minItems": 2, "maxItems": 24,
                   "items": {"type": "number"}}
      }
    },
    "y": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label"],
      "properties": {
        "label": {"type": "string", "minLength": 1, "maxLength": 80, "pattern": "\\S"},
        "scale": {"enum": ["linear", "log"], "default": "linear"},
        "unit": {"type": "string", "maxLength": 24}
      }
    },
    "series": {
      "type": "array", "minItems": 1, "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "values", "evidence_refs"],
        "properties": {
          "label": {"type": "string", "minLength": 1, "maxLength": 60, "pattern": "\\S"},
          "values": {"type": "array", "minItems": 2, "maxItems": 24,
                     "items": {"type": "number"}},
          "evidence_refs": {"type": "array", "uniqueItems": true,
                            "items": {"type": "string", "minLength": 1, "pattern": "\\S"}}
        }
      }
    },
    "source": {"type": "string", "minLength": 1, "maxLength": 120, "pattern": "\\S"},
    "note": {"type": "string", "minLength": 1, "maxLength": 160, "pattern": "\\S"}
  },
  "allOf": [
    {"if": {"properties": {"basis": {"const": "explain"}}},
     "then": {"required": ["illustrative"], "properties": {"illustrative": {"const": true}}}},
    {"if": {"properties": {"basis": {"const": "evidence"}}},
     "then": {"properties": {"illustrative": {"const": false}}}}
  ]
}
