{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Total-pipe page design 1.1: visual instructions with Story references",
  "type": "object",
  "required": ["schema_version", "deck_id", "setting", "pages"],
  "properties": {
    "schema_version": {"const": "1.1"},
    "deck_id": {"type": "string", "pattern": "\\S"},
    "setting": {
      "type": "object", "required": ["audience", "occasion", "reading"],
      "properties": {
        "audience": {"type": "string", "pattern": "\\S"},
        "occasion": {"enum": ["group-meeting", "research-report", "research-sharing", "lecture", "commercial"]},
        "reading": {"enum": ["spoken", "read", "mixed"]}
      }, "additionalProperties": true
    },
    "pages": {
      "type": "array", "minItems": 1, "maxItems": 40,
      "items": {
        "type": "object", "required": ["id", "content_refs", "design"],
        "properties": {
          "id": {"type": "string", "pattern": "\\S"},
          "content_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "\\S"}},
          "design": {
            "description": "Drawing, composition and presenter walkthrough instructions; custom structures welcome, no compiler vocabulary required.",
            "oneOf": [{"type": "string", "pattern": "\\S"}, {"type": "object", "minProperties": 1}]
          },
          "title": {"type": "string", "pattern": "\\S"},
          "figures": {"type": "array", "items": {"type": "string", "pattern": "\\S"}},
          "marks": {"type": "array", "items": {"type": "string", "pattern": "\\S"}}
        },
        "additionalProperties": true
      }
    }
  }, "additionalProperties": true
}
