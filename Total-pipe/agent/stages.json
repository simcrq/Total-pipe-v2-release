{
  "version": 1,
  "stages": [
    {
      "id": "intake",
      "kind": "input",
      "requires": [
        "source",
        "out_dir",
        "language",
        "presentation_type"
      ]
    },
    {
      "id": "queries",
      "kind": "agent",
      "artifact": "queries",
      "sources": [
        "pdf",
        "markdown"
      ],
      "instructions_ref": "queries",
      "max_attempts": 3
    },
    {
      "id": "evidence",
      "kind": "component",
      "adapter": "evidence",
      "sources": [
        "pdf",
        "markdown",
        "workflow"
      ],
      "timeout_sec": 1200
    },
    {
      "id": "model_selection",
      "kind": "input",
      "requires": [
        "model",
        "reasoning_effort",
        "selected_by_user"
      ],
      "sources": [
        "pdf",
        "markdown",
        "workflow"
      ]
    },
    {
      "id": "story_prompt",
      "kind": "component",
      "adapter": "story_prompt",
      "sources": [
        "pdf",
        "markdown",
        "workflow"
      ],
      "timeout_sec": 120
    },
    {
      "id": "story",
      "kind": "agent",
      "artifact": "story_plan",
      "sources": [
        "pdf",
        "markdown",
        "workflow"
      ],
      "instructions_ref": "story",
      "max_attempts": 2
    },
    {
      "id": "scientific_review",
      "kind": "agent",
      "artifact": "scientific_review",
      "sources": [
        "pdf",
        "markdown",
        "workflow"
      ],
      "prepare": "scientific_review",
      "skip_if": "legacy_story",
      "instructions_ref": "scientific_review",
      "max_attempts": 2
    },
    {
      "id": "rpa",
      "kind": "component",
      "adapter": "rpa",
      "sources": [
        "pdf",
        "markdown",
        "workflow"
      ],
      "timeout_sec": 600
    },
    {
      "id": "page_design",
      "kind": "agent",
      "artifact": "page_design",
      "sources": [
        "pdf",
        "markdown",
        "workflow"
      ],
      "prepare": "page_design",
      "instructions_ref": "page_design",
      "max_attempts": 2
    },
    {
      "id": "page_review",
      "kind": "agent",
      "artifact": "page_design_review",
      "sources": [
        "pdf",
        "markdown",
        "workflow"
      ],
      "prepare": "page_review",
      "skip_if": "legacy_page_design",
      "instructions_ref": "page_review",
      "max_attempts": 2
    },
    {
      "id": "page_scene",
      "kind": "agent",
      "artifact": "page_scene",
      "sources": [
        "pdf",
        "markdown",
        "workflow"
      ],
      "prepare": "page_scene",
      "skip_if": "deck_ir_mode",
      "instructions_ref": "page_scene",
      "max_attempts": 4
    },
    {
      "id": "deck_ir",
      "kind": "agent",
      "artifact": "deck_ir",
      "skip_if": "page_scene_mode",
      "instructions_ref": "ir",
      "max_attempts": 3
    },
    {
      "id": "design",
      "kind": "component",
      "adapter": "design",
      "skip_if": "design_complete",
      "timeout_sec": 120
    },
    {
      "id": "visual_design",
      "kind": "agent",
      "artifact": "visual_proposal",
      "skip_if": "design_complete",
      "instructions_ref": "design",
      "max_attempts": 3
    },
    {
      "id": "build",
      "kind": "component",
      "adapter": "build",
      "timeout_sec": 660
    },
    {
      "id": "candidate_ready",
      "kind": "terminal"
    }
  ],
  "instructions": {
    "queries": "agent/schemas/queries.schema.json",
    "story": "skills/total-pipe-deck/SKILL.md#2-科学故事story-planner",
    "page_design": "work/page_design_prompt.json",
    "page_review": "work/page_design_review_prompt.json",
    "page_scene": "work/page_scene_prompt.json",
    "ir": "work/ir_prompt.json",
    "design": "work/visual_prompt.json",
    "scientific_review": "work/scientific_review_prompt.json"
  }
}
