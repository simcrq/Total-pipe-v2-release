{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PageScene native preview request",
  "type": "object",
  "required": ["artifact_path"],
  "additionalProperties": false,
  "properties": {
    "artifact_path": {"type": "string", "minLength": 1},
    "page_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1},
      "description": "Selected PageScene page ids. Omit to preview every page."
    }
  }
}
