{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Actual source review of atomic scientific units before page design",
  "type":"object","additionalProperties":false,
  "required":["schema_version","method","reviewer","story_sha256","workflow_sha256","coverage","decisions"],
  "properties":{
    "schema_version":{"const":"1.0"},"method":{"const":"agent-source-review"},"reviewer":{"type":"string","pattern":"\\S"},
    "story_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"workflow_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "coverage":{"$ref":"#/$defs/check"},
    "decisions":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["id","unit_refs","checks"],"properties":{
      "id":{"type":"string","pattern":"\\S"},"unit_refs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"\\S"}},
      "checks":{"type":"object","additionalProperties":false,"required":["evidence_fidelity","atomic_scope","essential_conditions"],"properties":{
        "evidence_fidelity":{"$ref":"#/$defs/check"},"atomic_scope":{"$ref":"#/$defs/check"},"essential_conditions":{"$ref":"#/$defs/check"}}}}}}
  },
  "$defs":{"check":{"type":"object","additionalProperties":false,"required":["status","note"],"properties":{"status":{"enum":["pass","fail"]},"note":{"type":"string","pattern":"\\S"}}}}
}
