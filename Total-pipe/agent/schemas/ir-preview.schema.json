{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Isolated IR authoring preview",
  "type": "object",
  "required": ["artifact_path"],
  "properties": {
    "artifact_path": {"type": "string", "minLength": 1},
    "mode": {"enum": ["layout", "render"], "default": "render",
             "description": "layout measures the real draft and generates skeleton and unit diagnostics without OfficeCLI. render adds the HTML PNG."},
    "slide_ids": {"type": "array", "minItems": 1, "maxItems": 40, "uniqueItems": true,
                  "items": {"type": "string", "minLength": 1}}
  },
  "additionalProperties": false
}
